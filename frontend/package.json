{
  "name": "front-end-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write src *.ts *.js *.json index.html",
    "format:check": "prettier --check src *.ts *.js *.json index.html",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@hocuspocus/provider": "4.7.0",
    "@vitejs/plugin-react": "latest",
    "antd": "^6.6.5",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "monaco-editor": "0.52.2",
    "parse5": "^8.0.1",
    "postcss": "^8.5.30",
    "postcss-value-parser": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.4",
    "vite": "latest",
    "vscode-html-languageservice": "5.5.0",
    "y-indexeddb": "9.0.12",
    "y-monaco": "0.1.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fake-indexeddb": "^6.2.5",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "^5.0.1"
  }
}
