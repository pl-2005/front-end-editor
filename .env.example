DB_URL=jdbc:mysql://localhost:3306/web_editor?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_NAME=web_editor
DB_USERNAME=web_editor
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=web-editor
MINIO_INITIALIZE_BUCKET=true
ORPHAN_CLEANUP_CRON=0 30 3 * * *
ORPHAN_CLEANUP_GRACE_PERIOD=24h

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_SSL_ENABLED=false
AUTH_REDIS_NAMESPACE=web-editor:auth
JWT_ISSUER=web-editor
JWT_AUDIENCE=web-editor-api
JWT_ACCESS_TTL=10m
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_REFRESH_IDLE_TIMEOUT=30m
AUTH_REFRESH_MAX_LIFETIME=12h
AUTH_MAX_REFRESH_FAMILIES_PER_USER=5
# Uncomment when the local Redis service requires authentication.
# SPRING_DATA_REDIS_USERNAME=default
# SPRING_DATA_REDIS_PASSWORD=change-me

# Step05 controlled creation. Keep disabled for public deployment until Step11.
COLLAB_CREATION_ENABLED=false
COLLAB_INITIALIZER_URL=http://127.0.0.1:8091/internal/initialize
COLLAB_INITIALIZER_PORT=8091
COLLAB_INITIALIZER_SECRET=
COLLAB_STORAGE_SECRET=
COLLAB_RECOVERY_WINDOW=30d
COLLAB_CONFIRMATION_WINDOW=24h

# Step06 controlled collaboration. All public switches stay closed until Step11.
COLLAB_TICKET_ENABLED=false
COLLAB_GATEWAY_ENABLED=false
COLLAB_GATEWAY_PORT=8092
COLLAB_GATEWAY_INTERNAL_URL=http://127.0.0.1:8092
COLLAB_SPRING_URL=http://127.0.0.1:8080
COLLAB_GATEWAY_SECRET=
COLLAB_ALLOWED_ORIGINS=http://localhost:5173
COLLAB_GATEWAY_NONCE_PATH=../.codex-build/gateway-nonces.sqlite
COLLAB_INITIALIZER_NONCE_PATH=../.codex-build/initializer-nonces.sqlite
COLLAB_MAX_ROOMS=50
COLLAB_MAX_CONNECTIONS=200
COLLAB_MAX_ROOM_CONNECTIONS=20
COLLAB_MAX_MEMORY_BYTES=536870912
COLLAB_MAX_MESSAGES_PER_SECOND=100
COLLAB_MAX_BYTES_PER_SECOND=4194304
COLLAB_MAX_PENDING_BYTES=25165824
COLLAB_MAX_PENDING_UPDATES=10000

# Step10: stop/drain the gateway and close creation/tickets/gateway switches before maintenance.
COLLAB_MAINTENANCE_ENABLED=false
# Independent random >=32 byte key; do not share with other internal or JWT keys.
COLLAB_MAINTENANCE_SECRET=
COLLAB_MAINTENANCE_URL=http://127.0.0.1:8080
COLLAB_BACKUP_RETAIN_DAYS=30
# MYSQLDUMP_PATH may override the locally installed mysqldump executable.
